# ============================================================
# MIGR8 Environment Configuration — Example
# Copy this file to .env and fill in your values
# ============================================================

# Environment
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
POLICY_PORT=3002

# Control-Plane PostgreSQL (stores migration requests, plans, evidence, audits)
DATABASE_URL=postgresql://migr8:your_password@localhost:5439/migr8_control

# Redis (queue, pub/sub, distributed locks)
REDIS_URL=redis://localhost:6379

# Neon Target Database & Rehearsal Configuration
NEON_PROJECT_ID=your_neon_project_id
NEON_READONLY_TOKEN=your_neon_readonly_token
NEON_WRITE_TOKEN=your_neon_write_token
NEON_API_KEY=your_neon_api_key
NEON_MCP_URL=https://mcp.neon.tech/mcp

# Approval Token Security Boundary (HMAC-SHA256)
# Must be at least 32 characters in production
APPROVAL_TOKEN_SECRET=your-super-secure-approval-token-secret-key-32-chars
APPROVAL_TOKEN_TTL_SECONDS=120

# Deterministic Risk Engine Thresholds
LOCK_DURATION_THRESHOLD_MS=2000
MAX_REPLAN_ATTEMPTS=3
LARGE_TABLE_ROW_THRESHOLD=100000
HUGE_TABLE_ROW_THRESHOLD=1000000

# TrueForge Integration
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_API_KEY=your_trueforge_api_key

# TrueFoundry AI Gateway (Unified Model Routing)
TRUEFOUNDRY_GATEWAY_URL=https://gateway.truefoundry.ai
TRUEFOUNDRY_GATEWAY_API_KEY=your_truefoundry_gateway_api_key

# Model Routing Defaults (Connected to TrueFoundry Gateway)
INTENT_MODEL_ID=vm-polaris/openai
PLANNER_MODEL_ID=vm-polaris/openai
CRITIC_MODEL_ID=vm-polaris/openai
SUMMARY_MODEL_ID=vm-polaris/openai
MULTILINGUAL_MODEL_ID=vm-polaris/openai

# OpenAI Direct Fallback (optional)
OPENAI_API_KEY=

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001

# Demo & Failure Injection Flags
ENABLE_FAILURE_INJECTION=false
ENABLE_DEMO_MODE=true
